// Build settings for the FindRunClub app target.
//
// Your own values (Strava keys, signing team) go in Config/Secrets.xcconfig,
// which is git-ignored. Copy Config/Secrets.example.xcconfig to get started.
// Anything set there overrides the defaults below.

PRODUCT_BUNDLE_IDENTIFIER = com.findrunclub.app
DEVELOPMENT_TEAM =

// Strava API application credentials (https://www.strava.com/settings/api).
// Left empty, the app runs on built-in demo data.
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =

// Where the app refreshes its list of clubs per city (the "club directory").
// It falls back to the copy bundled in FindRunClub/Resources/ClubDirectory.json.
// ("https:/$()/" is how xcconfig files spell "https://".)
CLUB_DIRECTORY_URL = https:/$()/raw.githubusercontent.com/FindRunClub/FRC/main/FindRunClub/Resources/ClubDirectory.json

#include? "Secrets.xcconfig"
