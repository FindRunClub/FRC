// Copy this file to Config/Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is git-ignored, so your Strava secret never lands in the repo.

// From https://www.strava.com/settings/api ("Client ID" and "Client Secret").
// In that page, set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID = YOUR_CLIENT_ID
STRAVA_CLIENT_SECRET = YOUR_CLIENT_SECRET

// Optional, for running on a physical iPhone: your Apple Developer Team ID
// (Xcode > Settings > Accounts) and a bundle ID unique to your team.
// DEVELOPMENT_TEAM = ABCDE12345
// PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.findrunclub
